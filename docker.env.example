# Neon pooled connection string for the running app.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Neon direct (non-pooled) connection string for Prisma migrations.
DIRECT_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/DATABASE?sslmode=require"

# Generate a unique value for your local environment.
AUTH_SECRET="replace-with-a-long-random-secret"

# Google OAuth credentials for Auth.js.
AUTH_GOOGLE_ID="replace-with-google-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-client-secret"